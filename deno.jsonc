{
  "imports": {
    "@/": "./src/",
    "@test/": "./test/",
    "assets/": "./assets/",
    "@hono/swagger-ui": "jsr:@hono/swagger-ui@0.6.1",
    "@hono/zod-openapi": "jsr:@hono/zod-openapi@1.6.3",
    "@std/yaml": "jsr:@std/yaml@1.2.0",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/dotenv": "jsr:@std/dotenv@0.225.8",
    "@std/log": "jsr:@std/log@0.224.14",
    "@hono/hono": "jsr:@hono/hono@4.13.8",
    "@zod/zod": "jsr:@zod/zod@4.6.5",
    "date-fns": "npm:date-fns@4.4.0"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "exclude": [],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "camelcase",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-await-in-loop"
      ],
      "exclude": []
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": [
      "src/",
      "deno.jsonc"
    ],
    "exclude": []
  },
  "tasks": {
    "init": "deno task git-config && deno task setup-hooks && deno task build",
    "start": "deno run --allow-net --allow-read --watch src/Server.ts",
    "build": "deno fmt && deno task cached && deno run test",
    "test": "deno test --allow-read --allow-net=raw.githubusercontent.com:443",
    "cached": "sh .shell/cached.sh",
    "ci": "deno lint && deno fmt --check && deno run test",
    "coverage": "deno test --coverage=coverage_result --allow-read --allow-net=raw.githubusercontent.com:443",
    // git hooks
    "setup-hooks": "git config core.hooksPath .hooks && chmod +x .hooks/*",
    // git config
    "git-config": "deno task auto-crlf",
    "auto-crlf": "git config --global core.autocrlf false"
  }
}
